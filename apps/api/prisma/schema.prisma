// ─────────────────────────────────────────────────────────────
// Prisma schema — gestion-publica
//
// Multi-schema setup: core, auth, okr, audit, ai, metrics, planning
// Numeric weights and percentages use Decimal (never Float).
// All business tables carry organizationId for multi-tenant scoping.
// ─────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "auth", "okr", "audit", "ai", "metrics", "planning"]
}

// ─────────────────────────────────────────────────────────────
// core schema — Organizations, Periods, Users, Memberships, Modules
// ─────────────────────────────────────────────────────────────

model Organization {
  id                  String    @id @default(cuid())
  slug                String    @unique @db.VarChar(50)
  name                String    @db.VarChar(200)
  /// 'active' | 'inactive' — CHECK constraint in migration
  status              String    @default("active") @db.VarChar(10)
  deactivatedAt       DateTime? @map("deactivated_at")
  deactivatedByUserId String?   @map("deactivated_by_user_id")
  /// Organizational context for AI copilot (D3 ADR-0005)
  mission             String?   @db.Text
  vision              String?   @db.Text
  values              String?   @db.Text
  /// Arbitrary additional context for the LLM (strategic priorities, etc.)
  context             String?   @db.Text
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  periods                 Period[]
  memberships             UserOrganizationRole[]
  modules                 OrganizationModule[]
  objectives              Objective[]
  keyResults              KeyResult[]
  tasks                   Task[]
  projects                Project[]
  aiSettings              OrganizationAiSettings?
  aiPromptLogs            PromptLog[]
  aiUsageCounters         UsageCounter[]
  metrics                 Metric[]
  metricEntries           MetricEntry[]
  metricKrLinks           MetricKrLink[]
  objectiveIndicators     ObjectiveIndicator[]
  indicatorTargetPoints   IndicatorTargetPoint[]
  metricObjectiveContexts MetricObjectiveContext[]
  orgUnits                OrgUnit[]
  strategicPlans          StrategicPlan[]
  axes                    Axis[]

  @@index([status], map: "idx_organization_status")
  @@map("organization")
  @@schema("core")
}

model Period {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  /// Free-form label (1–50 chars). No format constraint after migration 20260428000001.
  code           String    @db.VarChar(50)
  /// 'open' | 'closed' | 'future' — CHECK constraint in migration
  status         String    @db.VarChar(10)
  startsAt       DateTime  @map("starts_at")
  endsAt         DateTime  @map("ends_at")
  closedAt       DateTime? @map("closed_at")
  closedByUserId String?   @map("closed_by_user_id")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  objectives   Objective[]
  metrics      Metric[]

  // Partial unique index uq_period_org_one_open ON (organization_id) WHERE status = 'open' AND deleted_at IS NULL
  // cannot be expressed in Prisma — added manually in migration SQL (D3-A).
  @@unique([organizationId, code], map: "uq_period_org_code")
  @@index([organizationId, status], map: "idx_period_org_status")
  @@index([deletedAt], map: "idx_period_deleted_at")
  @@map("period")
  @@schema("core")
}

model User {
  id           String    @id @default(cuid())
  /// JWT 'sub' claim from Auth0
  auth0Sub     String    @unique @map("auth0_sub")
  email        String    @unique
  displayName  String    @map("display_name") @db.VarChar(200)
  isSuperadmin Boolean   @default(false) @map("is_superadmin")
  lastSeenAt   DateTime? @map("last_seen_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  memberships     UserOrganizationRole[]
  ownedObjectives Objective[]            @relation("ObjectiveOwner")
  ownedKeyResults KeyResult[]            @relation("KrOwner")
  ownedTasks      Task[]                 @relation("TaskOwner")
  ownedProjects   Project[]              @relation("ProjectOwner")
  aiPromptLogs    PromptLog[]

  @@index([isSuperadmin], map: "idx_user_superadmin")
  @@map("user")
  @@schema("core")
}

/// Árbol de unidades de gobierno (ADR-0009, N3). central -> ministry -> area, profundidad <= 4.
/// CHECK de kind, de coherencia kind/parent y unique parcial de la raíz central: SQL manual en la migración.
model OrgUnit {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  parentId       String?   @map("parent_id")
  /// 'central' | 'ministry' | 'area' — CHECK constraint in migration
  kind           String    @db.VarChar(10)
  name           String    @db.VarChar(200)
  vision         String?   @db.Text
  mission        String?   @db.Text
  order          Int       @default(0)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       OrgUnit?               @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     OrgUnit[]              @relation("OrgUnitTree")
  memberships  UserOrganizationRole[]
  objectives   Objective[]
  projects     Project[]

  // Partial unique uq_org_unit_central_root ON (organization_id) WHERE kind = 'central' AND deleted_at IS NULL
  // cannot be expressed in Prisma — added manually in migration SQL (RN-P1).
  @@index([organizationId, parentId], map: "idx_org_unit_org_parent")
  @@index([deletedAt], map: "idx_org_unit_deleted_at")
  @@map("org_unit")
  @@schema("core")
}

model UserOrganizationRole {
  userId           String   @map("user_id")
  organizationId   String   @map("organization_id")
  roleId           String   @map("role_id")
  assignedAt       DateTime @default(now()) @map("assigned_at")
  assignedByUserId String   @map("assigned_by_user_id")
  /// Alcance de escritura (RN-P19/P20). null = toda la org (unidad central).
  orgUnitId        String?  @map("org_unit_id")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id])
  orgUnit      OrgUnit?     @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)

  @@id([userId, organizationId])
  @@index([organizationId], map: "idx_uor_org")
  @@index([roleId], map: "idx_uor_role")
  @@index([orgUnitId], map: "idx_uor_org_unit")
  @@map("user_organization_role")
  @@schema("core")
}

model OrganizationModule {
  organizationId   String    @map("organization_id")
  moduleKey        String    @map("module_key")
  enabledAt        DateTime  @default(now()) @map("enabled_at")
  enabledByUserId  String    @map("enabled_by_user_id")
  disabledAt       DateTime? @map("disabled_at")
  disabledByUserId String?   @map("disabled_by_user_id")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  module       Module       @relation(fields: [moduleKey], references: [key], onDelete: Restrict)

  @@id([organizationId, moduleKey])
  @@index([organizationId, disabledAt], map: "idx_om_org_active")
  @@map("organization_module")
  @@schema("core")
}

model Module {
  key         String   @id @db.VarChar(64)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  enablements OrganizationModule[]

  @@map("module")
  @@schema("core")
}

// ─────────────────────────────────────────────────────────────
// auth schema — Roles, Permissions, Role-Permission assignments
// ─────────────────────────────────────────────────────────────

model Role {
  id              String                 @id @default(cuid())
  key             String                 @unique @db.VarChar(64)
  name            String                 @db.VarChar(120)
  description     String?                @db.Text
  createdAt       DateTime               @default(now()) @map("created_at")
  rolePermissions RolePermission[]
  memberships     UserOrganizationRole[]

  @@map("role")
  @@schema("auth")
}

model Permission {
  key             String           @id @db.VarChar(64)
  description     String           @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  rolePermissions RolePermission[]

  @@map("permission")
  @@schema("auth")
}

model RolePermission {
  roleId        String     @map("role_id")
  permissionKey String     @map("permission_key")
  assignedAt    DateTime   @default(now()) @map("assigned_at")
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@index([permissionKey], map: "idx_role_permission_key")
  @@map("role_permission")
  @@schema("auth")
}

// ─────────────────────────────────────────────────────────────
// audit schema — append-only event log
// ─────────────────────────────────────────────────────────────

model AuditEvent {
  id             String   @id @default(cuid())
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorId        String   @map("actor_id") @db.VarChar(64)
  organizationId String?  @map("organization_id")
  entityType     String   @map("entity_type") @db.VarChar(64)
  entityId       String   @map("entity_id") @db.VarChar(64)
  action         String   @db.VarChar(80)
  diff           Json     @db.JsonB
  requestId      String   @map("request_id") @db.Uuid

  // No @relation annotations — cross-schema FKs added via raw SQL in migration.

  @@index([organizationId, occurredAt(sort: Desc)], map: "idx_event_org_occurred")
  @@index([entityType, entityId, occurredAt(sort: Desc)], map: "idx_event_entity")
  @@index([actorId, occurredAt(sort: Desc)], map: "idx_event_actor_occurred")
  @@index([occurredAt(sort: Desc)], map: "idx_event_occurred")
  @@index([requestId], map: "idx_event_request")
  @@map("event")
  @@schema("audit")
}

// ─────────────────────────────────────────────────────────────
// okr schema — Objectives, Key Results, Tasks
// Weights and progress in basis points (Int 0..10000).
// Cascade math lives in packages/okr-domain (pure functions).
// ─────────────────────────────────────────────────────────────

model Objective {
  id                        String    @id @default(cuid())
  organizationId            String    @map("organization_id")
  periodId                  String    @map("period_id")
  title                     String    @db.VarChar(200)
  description               String?   @db.Text
  ownerUserId               String?   @map("owner_user_id")
  /// Unidad (ministry | area, RN-P3). Nullable hasta la fase migrate (ADR-0009 D6); el service valida kind y org.
  orgUnitId                 String?   @map("org_unit_id")
  /// Eje (N2) del plan activo; opcional (RN-P2).
  axisId                    String?   @map("axis_id")
  /// Deprecado (camino KR legacy; se elimina en el contract, ADR-0009 D6).
  progressCachedBp          Int       @default(0) @map("progress_cached_bp")
  /// Avance de resultado (desde indicadores, RN-P8). Nunca se combina con el de gestión.
  resultProgressCachedBp    Int       @default(0) @map("result_progress_cached_bp")
  /// Avance de gestión (desde proyectos, RN-P8). Nunca se combina con el de resultado.
  executionProgressCachedBp Int       @default(0) @map("execution_progress_cached_bp")
  deletedAt                 DateTime? @map("deleted_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  period       Period       @relation(fields: [periodId], references: [id], onDelete: Restrict)
  owner        User?        @relation("ObjectiveOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  orgUnit      OrgUnit?     @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)
  axis         Axis?        @relation(fields: [axisId], references: [id], onDelete: Restrict)
  keyResults   KeyResult[]
  projects     Project[]

  @@index([organizationId, periodId], map: "idx_objective_org_period")
  @@index([periodId], map: "idx_objective_period")
  @@index([ownerUserId], map: "idx_objective_owner")
  @@index([orgUnitId], map: "idx_objective_org_unit")
  @@index([axisId], map: "idx_objective_axis")
  @@map("objective")
  @@schema("okr")
}

model KeyResult {
  id               String    @id @default(cuid())
  objectiveId      String    @map("objective_id")
  organizationId   String    @map("organization_id")
  title            String    @db.VarChar(200)
  description      String?   @db.Text
  ownerUserId      String?   @map("owner_user_id")
  weightBp         Int       @map("weight_bp")
  progressCachedBp Int       @default(0) @map("progress_cached_bp")
  /// 'manual' (progress from tasks) | 'automatic' (progress from a linked Metric) — CHECK constraint in migration. Default 'manual' (M2).
  progressMode     String    @default("manual") @map("progress_mode") @db.VarChar(10)
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  objective    Objective    @relation(fields: [objectiveId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner        User?        @relation("KrOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  tasks        Task[]
  // metric_kr_link references key_result via a cross-schema FK added in raw SQL
  // (no @relation — mirrors the audit.event → core.* pattern).

  @@index([objectiveId], map: "idx_kr_objective")
  @@index([ownerUserId], map: "idx_kr_owner_user")
  @@map("key_result")
  @@schema("okr")
}

model Project {
  id                         String    @id @default(cuid())
  objectiveId                String    @map("objective_id")
  organizationId             String    @map("organization_id")
  /// Unidad del proyecto: la del objetivo o una descendiente (RN-P4). Lo valida el service por puerto.
  orgUnitId                  String    @map("org_unit_id")
  title                      String    @db.VarChar(200)
  description                String?   @db.Text
  ownerUserId                String?   @map("owner_user_id")
  /// Opcional, todo-o-nada entre proyectos hermanos (RN-P6). Basis points 0..10000.
  weightBp                   Int?      @map("weight_bp")
  startsAt                   DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt                     DateTime  @map("ends_at") @db.Timestamptz(6)
  /// 'from_tasks' | 'from_indicator' — CHECK constraint in migration. Hoy solo 'from_tasks' es operable (F4/F7 habilita el otro).
  progressMode               String    @default("from_tasks") @map("progress_mode") @db.VarChar(15)
  /// FK a metrics.objective_indicator por SQL crudo (migración 20261008000002); sin relación en Prisma (convención cross-schema).
  sourceObjectiveIndicatorId String?   @map("source_objective_indicator_id")
  progressCachedBp           Int       @default(0) @map("progress_cached_bp")
  /// Idempotencia de la migración KR -> Project (ADR-0009 D6). Unique parcial en la migración SQL.
  legacyKeyResultId          String?   @map("legacy_key_result_id")
  deletedAt                  DateTime? @map("deleted_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  objective    Objective    @relation(fields: [objectiveId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orgUnit      OrgUnit      @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)
  owner        User?        @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  tasks        Task[]

  // Partial unique uq_project_legacy_key_result ON (legacy_key_result_id) WHERE legacy_key_result_id IS NOT NULL
  // cannot be expressed in Prisma — added manually in migration SQL (ADR-0009 D6).
  @@index([organizationId, objectiveId], map: "idx_project_org_objective")
  @@index([objectiveId], map: "idx_project_objective")
  @@index([orgUnitId], map: "idx_project_org_unit")
  @@index([ownerUserId], map: "idx_project_owner")
  @@index([deletedAt], map: "idx_project_deleted_at")
  @@map("project")
  @@schema("okr")
}

model Task {
  id             String    @id @default(cuid())
  /// Camino KR legacy. Exactamente uno entre keyResultId y projectId (CHECK chk_task_parent_xor).
  keyResultId    String?   @map("key_result_id")
  /// Proyecto (N5). Exactamente uno entre keyResultId y projectId.
  projectId      String?   @map("project_id")
  organizationId String    @map("organization_id")
  title          String    @db.VarChar(200)
  description    String?   @db.Text
  ownerUserId    String?   @map("owner_user_id")
  /// Opcional (RN-P6, todo-o-nada entre hermanos). Obligatorio en el camino KR (CHECK chk_task_kr_weight).
  weightBp       Int?      @map("weight_bp")
  progressBp     Int       @default(0) @map("progress_bp")
  /// Scheduled start date for this task. Must be >= parent Period.startsAt.
  startsAt       DateTime  @map("starts_at") @db.Timestamptz(6)
  /// Scheduled end date for this task. Must be <= parent Period.endsAt.
  endsAt         DateTime  @map("ends_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  keyResult    KeyResult?   @relation(fields: [keyResultId], references: [id], onDelete: Restrict)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner        User?        @relation("TaskOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([keyResultId], map: "idx_task_kr")
  @@index([projectId], map: "idx_task_project")
  @@index([ownerUserId], map: "idx_task_owner_user")
  @@map("task")
  @@schema("okr")
}

// ─────────────────────────────────────────────────────────────
// metrics schema — Metric catalog + entries (Módulo 1 "Indicadores de gestión")
// Values use Decimal(18,4) — never Float. Increments, not accumulated values.
// Per docs/features/indicadores-modelo-comun.md.
// ─────────────────────────────────────────────────────────────

model Metric {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  periodId       String    @map("period_id")
  name           String    @db.VarChar(200)
  /// 'number' | 'percent' | 'currency' — CHECK constraint in migration
  unit           String    @db.VarChar(10)
  /// 'increasing' | 'decreasing' — CHECK constraint in migration
  direction      String    @db.VarChar(10)
  /// 'weekly' | 'biweekly' | 'monthly' | 'quarterly' | 'semiannual' | 'annual' — CHECK constraint in migration. Immutable after creation (RN-M2).
  frequency      String    @db.VarChar(10)
  /// 'output' | 'outcome' — CHECK constraint in migration (RN-P12).
  kind           String    @default("output") @db.VarChar(10)
  /// Fuente del dato.
  source         String?   @db.VarChar(500)
  /// Fórmula / definición del indicador.
  description    String?   @db.VarChar(2000)
  /// Starting value of the expected linear curve. Default 0.
  baselineValue  Decimal   @default(0) @map("baseline_value") @db.Decimal(18, 4)
  /// Period target value.
  targetValue    Decimal   @map("target_value") @db.Decimal(18, 4)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  period              Period                   @relation(fields: [periodId], references: [id], onDelete: Restrict)
  entries             MetricEntry[]
  krLinks             MetricKrLink[]
  objectiveContexts   MetricObjectiveContext[]
  objectiveIndicators ObjectiveIndicator[]

  // Case-insensitive partial unique index uq_metric_org_period_name ON
  // (organization_id, period_id, lower(name)) WHERE deleted_at IS NULL
  // cannot be expressed in Prisma — added manually in migration SQL (RN-M1).
  @@index([organizationId, periodId], map: "idx_metric_org_period")
  @@index([deletedAt], map: "idx_metric_deleted_at")
  @@map("metric")
  @@schema("metrics")
}

// ─────────────────────────────────────────────────────────────
// Módulo 2 "Indicadores en OKRs" — Metric ↔ KR link + objective context.
// FKs to okr.* are cross-schema and added via raw SQL in the migration.
// Per docs/features/indicadores-okr.md.
// ─────────────────────────────────────────────────────────────

model MetricKrLink {
  id              String   @id @default(cuid())
  metricId        String   @map("metric_id")
  /// A KR has at most one link (unique). FK to okr.key_result via raw SQL.
  keyResultId     String   @unique @map("key_result_id")
  organizationId  String   @map("organization_id")
  /// Snapshot at link time (default: metric's current accumulated value). Editable (D-O4).
  baselineValue   Decimal  @map("baseline_value") @db.Decimal(18, 4)
  targetValue     Decimal  @map("target_value") @db.Decimal(18, 4)
  /// 'increasing' | 'decreasing' — inherited from the Metric at link time, editable. CHECK in migration.
  direction       String   @db.VarChar(10)
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  metric       Metric       @relation(fields: [metricId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([metricId], map: "idx_mkl_metric")
  @@index([organizationId], map: "idx_mkl_org")
  @@map("metric_kr_link")
  @@schema("metrics")
}

/// Vínculo objetivo <-> métrica (N4, ADR-0009 D2). Manda sobre Metric para base, meta y dirección (D8).
/// FK a okr.objective por SQL crudo (sin relación en Prisma, convención cross-schema).
/// Únicos parciales en la migración: (objective_id, metric_id) WHERE deleted_at IS NULL (no expresable en Prisma).
model ObjectiveIndicator {
  id                String    @id @default(cuid())
  organizationId    String    @map("organization_id")
  objectiveId       String    @map("objective_id")
  metricId          String    @map("metric_id")
  baselineValue     Decimal   @map("baseline_value") @db.Decimal(18, 4)
  targetValue       Decimal   @map("target_value") @db.Decimal(18, 4)
  /// 'increasing' | 'decreasing' — CHECK constraint in migration.
  direction         String    @db.VarChar(10)
  /// Opcional, todo-o-nada entre indicadores hermanos (RN-P6). Basis points 0..10000.
  weightBp          Int?      @map("weight_bp")
  /// 'linear' | 'manual' | 'from_projects' — CHECK in migration. 'from_projects' recién es operable con ProjectContribution (F7).
  expectedCurveMode String    @default("linear") @map("expected_curve_mode") @db.VarChar(15)
  /// 'independent' | 'execution_feeds_indicator' | 'indicator_feeds_execution' — CHECK in migration (RN-P14b).
  linkMode          String    @default("independent") @map("link_mode") @db.VarChar(30)
  /// Avance de este indicador (bp). Alimenta Objective.resultProgressCachedBp.
  progressCachedBp  Int       @default(0) @map("progress_cached_bp")
  /// Idempotencia de la migración KR -> indicador (ADR-0009 D6). Unique parcial en la migración SQL.
  legacyKeyResultId String?   @map("legacy_key_result_id")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  metric       Metric                 @relation(fields: [metricId], references: [id], onDelete: Restrict)
  targetPoints IndicatorTargetPoint[]

  @@index([organizationId, objectiveId], map: "idx_objective_indicator_org_objective")
  @@index([objectiveId], map: "idx_objective_indicator_objective")
  @@index([metricId], map: "idx_objective_indicator_metric")
  @@index([deletedAt], map: "idx_objective_indicator_deleted_at")
  @@map("objective_indicator")
  @@schema("metrics")
}

/// Punto de la curva esperada manual de un indicador (RN-P17): acumulado esperado en un bucket.
/// El último punto (por fecha) es igual a la meta del indicador; lo valida el service. Se reemplazan en bloque
/// (PUT) y el before/after queda en audit, por eso no llevan soft delete.
model IndicatorTargetPoint {
  id                   String   @id @default(cuid())
  organizationId       String   @map("organization_id")
  objectiveIndicatorId String   @map("objective_indicator_id")
  /// Primer día del bucket (DATE, UTC), como MetricEntry.bucketDate.
  bucketDate           DateTime @map("bucket_date") @db.Date
  /// Acumulado esperado (absoluto) a esa fecha. Decimal(18,4), nunca Float.
  expectedValue        Decimal  @map("expected_value") @db.Decimal(18, 4)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  objectiveIndicator ObjectiveIndicator @relation(fields: [objectiveIndicatorId], references: [id], onDelete: Restrict)

  @@unique([objectiveIndicatorId, bucketDate], map: "uq_indicator_target_point_bucket")
  @@index([organizationId], map: "idx_indicator_target_point_org")
  @@map("indicator_target_point")
  @@schema("metrics")
}

model MetricObjectiveContext {
  metricId        String   @map("metric_id")
  objectiveId     String   @map("objective_id")
  organizationId  String   @map("organization_id")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  metric       Metric       @relation(fields: [metricId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([metricId, objectiveId])
  @@index([objectiveId], map: "idx_moc_objective")
  @@map("metric_objective_context")
  @@schema("metrics")
}

model MetricEntry {
  id              String    @id @default(cuid())
  metricId        String    @map("metric_id")
  organizationId  String    @map("organization_id")
  /// First day of the bucket (DATE, UTC). Must be a valid bucket boundary (RN-C4).
  bucketDate      DateTime  @map("bucket_date") @db.Date
  /// INCREMENT for the bucket (not accumulated). May be negative (correction, RN-C6).
  incrementValue  Decimal   @map("increment_value") @db.Decimal(18, 4)
  comment         String?   @db.Text
  createdByUserId String    @map("created_by_user_id")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  metric       Metric       @relation(fields: [metricId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([metricId, bucketDate], map: "idx_metric_entry_metric_bucket")
  @@index([organizationId], map: "idx_metric_entry_org")
  @@map("metric_entry")
  @@schema("metrics")
}

// ─────────────────────────────────────────────────────────────
// ai schema — AI Copilot config, prompt log, usage counters
// Per ADR 0005: provider abstraction, quota enforcement, append-only prompt log
// ─────────────────────────────────────────────────────────────

model OrganizationAiSettings {
  /// One row per organization — organizationId is the PK
  organizationId      String   @id @map("organization_id")
  /// 'anthropic' | 'openai' — CHECK constraint in migration
  provider            String   @default("anthropic") @db.VarChar(16)
  /// Model name. Default is Haiku to keep costs low; orgs can opt into Sonnet via settings.
  modelName           String   @default("claude-haiku-4-5-20251001") @map("model_name") @db.VarChar(64)
  /// Soft monthly token quota — 0 means unlimited (superadmin bypass)
  monthlyTokenQuota   Int      @default(500000) @map("monthly_token_quota")
  /// Soft monthly call quota
  monthlyCallQuota    Int      @default(1000) @map("monthly_call_quota")
  /// Whether AI copilot is enabled for this org
  enabled             Boolean  @default(true)
  /// Reserved for future BYOK iteration (D11)
  byokApiKeyEncrypted String?  @map("byok_api_key_encrypted") @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_ai_settings")
  @@schema("ai")
}

model PromptLog {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  /// 'draft' | 'validate' — CHECK constraint in migration
  operationType  String   @map("operation_type") @db.VarChar(16)
  /// 'objective' | 'key_result' — CHECK constraint in migration
  entityType     String   @map("entity_type") @db.VarChar(32)
  /// 'anthropic' | 'openai'
  provider       String   @db.VarChar(16)
  model          String   @db.VarChar(64)
  /// SHA-256 hex of the normalized user prompt (for cache lookup D9)
  promptHash     String   @map("prompt_hash") @db.VarChar(64)
  promptText     String   @map("prompt_text") @db.Text
  responseText   String   @map("response_text") @db.Text
  tokensIn       Int      @map("tokens_in")
  tokensOut      Int      @map("tokens_out")
  latencyMs      Int      @map("latency_ms")
  /// True when this response was served from cache
  cacheHit       Boolean  @default(false) @map("cache_hit")
  success        Boolean  @default(true)
  errorCode      String?  @map("error_code") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)], map: "idx_prompt_log_org_created")
  @@index([organizationId, entityType, promptHash, createdAt(sort: Desc)], map: "idx_prompt_log_cache_lookup")
  @@index([userId, createdAt(sort: Desc)], map: "idx_prompt_log_user_created")
  @@map("prompt_log")
  @@schema("ai")
}

model UsageCounter {
  organizationId String   @map("organization_id")
  /// Format 'YYYY-MM' — CHECK constraint in migration
  yearMonth      String   @map("year_month") @db.VarChar(7)
  /// 'draft' | 'validate'
  operationType  String   @map("operation_type") @db.VarChar(16)
  callsCount     Int      @default(0) @map("calls_count")
  tokensInTotal  Int      @default(0) @map("tokens_in_total")
  tokensOutTotal Int      @default(0) @map("tokens_out_total")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, yearMonth, operationType])
  @@index([organizationId, yearMonth], map: "idx_usage_counter_org_month")
  @@map("usage_counter")
  @@schema("ai")
}

// ─────────────────────────────────────────────────────────────
// planning schema — Plan de gobierno (N1) y ejes (N2). ADR-0009 D2.
// ─────────────────────────────────────────────────────────────

/// Visión de gobierno (N1). Un solo plan 'active' por org (RN-P2).
/// CHECK de status, CHECK mandate_ends_at > mandate_starts_at y unique parcial
/// uq_strategic_plan_active (organization_id) WHERE status = 'active': SQL manual en la migración.
model StrategicPlan {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  title           String   @db.VarChar(200)
  vision          String   @db.Text
  mandateStartsAt DateTime @map("mandate_starts_at")
  mandateEndsAt   DateTime @map("mandate_ends_at")
  /// 'active' | 'archived' — CHECK constraint in migration
  status          String   @default("active") @db.VarChar(10)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  axes         Axis[]

  @@index([organizationId], map: "idx_strategic_plan_org")
  @@map("strategic_plan")
  @@schema("planning")
}

/// Eje (N2): transversal a las unidades, opcional. Soft delete.
model Axis {
  id              String    @id @default(cuid())
  strategicPlanId String    @map("strategic_plan_id")
  organizationId  String    @map("organization_id")
  name            String    @db.VarChar(200)
  description     String?   @db.Text
  order           Int       @default(0)
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  strategicPlan StrategicPlan @relation(fields: [strategicPlanId], references: [id], onDelete: Restrict)
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  objectives    Objective[]

  @@index([organizationId, strategicPlanId], map: "idx_axis_org_plan")
  @@index([deletedAt], map: "idx_axis_deleted_at")
  @@map("axis")
  @@schema("planning")
}
