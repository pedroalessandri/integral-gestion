# ─────────────────────────────────────────────────────────────
# apps/api — Environment variables
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# Database (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://gp_user:gp_password@localhost:5432/gestion_publica?schema=public"

# Auth0
# Replace with your tenant values from the Auth0 dashboard.
# On startup the app logs a WARN if these are still placeholders.
AUTH0_ISSUER_BASE_URL="https://placeholder.auth0.com"
AUTH0_AUDIENCE="https://api.gestion-publica.placeholder"

# Bootstrapping
# Email of the first superadmin user. Used by CoreModule on first startup.
CORE_BOOTSTRAP_SUPERADMIN_EMAIL="admin@example.com"

# Rate limiting (optional — NestJS ThrottlerModule defaults apply if absent)
# THROTTLE_TTL_SECONDS=60
# THROTTLE_LIMIT=100

# Cron — Period auto-close (cron expression, default: hourly)
PERIOD_AUTO_CLOSE_CRON=0 * * * *

# AI Copilot (ADR-0005) — optional in dev, required in prod when AI is enabled
AI_DEFAULT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...  (optional, for future OpenAI provider)

# Conector MCP para asistentes de IA (ADR-0010). Apagado por defecto: con MCP_ENABLED=false, /mcp y la metadata
# (/.well-known/oauth-protected-resource) responden 404. Nunca cargues valores reales acá: van en el entorno del deploy.
MCP_ENABLED=false
# URL EXACTA del endpoint MCP (https, termina en /mcp, sin query ni fragmento). Es el identificador del recurso
# (RFC 9728) y la audiencia por defecto del token. Obligatoria si MCP_ENABLED=true.
# MCP_RESOURCE_URL=https://<host-publico-de-la-api>/mcp
# Identifier de la API del conector en Auth0 (audiencia que se exige al token). Por defecto, MCP_RESOURCE_URL.
# MCP_AUTH0_AUDIENCE=https://<host-publico-de-la-api>/mcp
# Orígenes permitidos si el request trae Origin (coma-separados). Vacío en producción; en dev: http://localhost:*
# MCP_ALLOWED_ORIGINS=
# Límites por usuario (ADR-0010 D8) y tope de caracteres por respuesta de herramienta (D9).
# MCP_RATE_READ_PER_MIN=60
# MCP_RATE_WRITE_PER_MIN=10
# MCP_RATE_WRITE_PER_DAY=300
# MCP_MAX_RESPONSE_CHARS=60000
